# ==============================================================================
# PulseWallet - Production Environment Template (.env.production)
#
# Copy this file to .env.production or export variables to your cloud provider
# (Render, Railway, Fly.io, AWS ECS, GCP Cloud Run, DigitalOcean, Kubernetes).
#
# NEVER commit the real .env.production with live credentials to Git.
# ==============================================================================

# ---- Database (PostgreSQL) ---------------------------------------------------
DB_NAME=pulsewallet_db
DB_USERNAME=pulsewallet
# Generate a strong password: openssl rand -base64 24
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
# If using a managed database provider (Supabase, Neon, AWS RDS), set full URL:
# DATABASE_URL=jdbc:postgresql://<host>:<port>/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://postgres:5432/pulsewallet_db
DB_POOL_MAX=10
DB_POOL_MIN=2

# ---- Spring Boot Backend -----------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
PULSEWALLET_BASE_CURRENCY=INR

# ---- JWT Security (CRITICAL: HS256 requires >= 256-bit / 32-byte key) -------
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_SECURE_RANDOMLY_GENERATED_BASE64_KEY_AT_LEAST_48_BYTES
JWT_EXPIRATION_MINUTES=60

# ---- External Microservices & Machine Learning -------------------------------
# In Docker Compose, the fraud detection service is accessible via hostname 'fraud-detection'
FRAUD_API_URL=http://fraud-detection:8000
FRAUD_SCORE_THRESHOLD=0.50
FRAUD_API_CONNECT_TIMEOUT_MS=3000
FRAUD_API_READ_TIMEOUT_MS=5000

# ---- CORS Allowed Origins ---------------------------------------------------
# Set to your production domains (e.g., https://app.pulsewallet.com)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://pulsewallet.app,https://yourdomain.com

# ---- Frontend Service -------------------------------------------------------
FRONTEND_PORT=80
VITE_API_BASE_URL=/api

# ---- Currency Exchange API --------------------------------------------------
EXCHANGE_RATE_BASE_URL=https://open.er-api.com/v6/latest
PULSEWALLET_EXCHANGE_RATE_CACHE_MS=1800000
