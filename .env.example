# ==============================================================================
# PulseWallet - environment template
#
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows cmd)
#   Copy-Item .env.example .env   (PowerShell)
#
# Then edit .env. Never commit .env - it is gitignored.
#
# WHO READS THIS FILE:
#   - docker compose reads .env automatically for the Postgres container.
#   - Spring Boot does NOT read .env files. The dev profile has matching
#     defaults baked in, so `./mvnw spring-boot:run` works without exporting
#     anything. Only if you CHANGE a value below must you also export it to
#     your shell (or set it in your IDE run configuration) so the app agrees
#     with the container.
# ==============================================================================

# ---- Database ----------------------------------------------------------------
DB_NAME=pulsewallet_db
DB_USERNAME=pulsewallet
DB_PASSWORD=pulsewallet
DB_HOST=localhost
# Host-side port. Change to 5433 if you already have Postgres on 5432.
DB_PORT=5432

# ---- Application -------------------------------------------------------------
SERVER_PORT=8080
# dev | prod
SPRING_PROFILES_ACTIVE=dev

# Comma-separated. 3000 = Create React App, 5173 = Vite.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT (used from Milestone 2 onward) --------------------------------------
# Must be at least 32 bytes for HS256. Generate a real one:
#   openssl rand -base64 48
# Leave the placeholder for now; auth is not wired up yet.
JWT_SECRET=replace-me-with-a-long-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ---- Fraud detection microservice (Milestone 4) ------------------------------
FRAUD_SERVICE_URL=http://localhost:8001
FRAUD_SERVICE_TIMEOUT_MS=3000
# Score at or above which a transaction is flagged. Tune after model eval.
FRAUD_SCORE_THRESHOLD=0.75

# ---- pgAdmin (only used with: docker compose --profile tools up -d) ----------
PGADMIN_EMAIL=admin@pulsewallet.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
