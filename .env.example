# ==============================================================================
# PulseWallet - environment template
#
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows cmd)
#   Copy-Item .env.example .env   (PowerShell)
#
# Then edit .env. Never commit .env - it is gitignored.
#
# WHO READS THIS FILE:
#   - docker compose reads .env automatically for the Postgres container.
#   - Spring Boot does NOT read .env files. Most values below have matching
#     defaults baked into the dev profile, so you only need to export a
#     value you CHANGE, to your shell (or your IDE run configuration), so the
#     app agrees with the container.
#   - JWT_SECRET is the one exception: application.properties gives it no
#     default on purpose, so you MUST export it (or your IDE run config must
#     set it) before `./mvnw spring-boot:run` will start. See the JWT section
#     below.
# ==============================================================================

# ---- Database ----------------------------------------------------------------
DB_NAME=pulsewallet_db
DB_USERNAME=pulsewallet
DB_PASSWORD=pulsewallet
DB_HOST=localhost
# Host-side port. Change to 5433 if you already have Postgres on 5432.
DB_PORT=5432

# ---- Application -------------------------------------------------------------
SERVER_PORT=8080
# dev | prod
SPRING_PROFILES_ACTIVE=dev

# Comma-separated. 3000 = Create React App, 5173 = Vite.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT (Milestone 2: required) ----------------------------------------------
# REQUIRED - the app will not start without this exported. Must be at least
# 32 bytes for HS256. Generate a real one:
#   openssl rand -base64 48
# The placeholder below works (it is 32+ bytes) but is public in git history,
# so swap it for a generated value before this ever leaves your laptop.
JWT_SECRET=replace-me-with-a-long-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
# Not implemented yet - JwtService issues access tokens only, no refresh flow.
JWT_REFRESH_EXPIRATION_DAYS=7

# ---- Fraud detection microservice (Milestone 4) ------------------------------
FRAUD_SERVICE_URL=http://localhost:8001
FRAUD_SERVICE_TIMEOUT_MS=3000
# Score at or above which a transaction is flagged. Tune after model eval.
FRAUD_SCORE_THRESHOLD=0.75

# ---- pgAdmin (only used with: docker compose --profile tools up -d) ----------
PGADMIN_EMAIL=admin@pulsewallet.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
